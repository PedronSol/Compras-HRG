# Copie para backend/.env e ajuste. Gere as chaves com:  python -m rg.cli gerar-chaves
RG_AMBIENTE=desenvolvimento

# Segredos (mínimo 32 caracteres). NUNCA versionar os valores reais.
RG_SECRET_KEY=
RG_SIGNATURE_SECRET=
# Chaves Fernet separadas por vírgula; a primeira é a ativa (rotação: adicione a nova no início)
RG_ENCRYPTION_KEYS=

# PostgreSQL >= 15. O usuário da API deve ser membro de rg_app e não pode ser dono das tabelas.
RG_DATABASE_URL=postgresql://rg_api:senha@localhost:5432/rg_hospital
RG_DB_APP_ROLE=rg_app
RG_DB_POOL_MIN=2
RG_DB_POOL_MAX=20

# Sessões
RG_SESSION_COOKIE_SECURE=false
RG_SESSION_IDLE_MINUTES=60
RG_SESSION_ABSOLUTE_HOURS=12

# Senhas / bloqueio
RG_SENHA_MIN_CARACTERES=12
RG_LOGIN_MAX_TENTATIVAS=5
RG_LOGIN_BLOQUEIO_MINUTOS=15
RG_HIBP_ENABLED=true

# Arquivos (cifrados em repouso) e OCR
RG_STORAGE_DIR=./storage
RG_MAX_UPLOAD_MB=10
RG_OCR_ENABLED=true
RG_OCR_WORKERS=2
# Opcional: caminho do tesseract.exe (com idioma "por"). Sem ele, usa RapidOCR embutido.
RG_TESSERACT_CMD=

# Infraestrutura
RG_TRUSTED_PROXIES=0
RG_RATELIMIT_STORAGE_URI=memory://
RG_SLA_JOB_INTERVAL_SECONDS=300
RG_TIMEZONE=America/Sao_Paulo
RG_INSTITUICAO=Hospital Rio Grande
