# Copie para deploy/.env.producao e preencha. NUNCA versione o arquivo preenchido.
# Gere os segredos da aplicação com:  python -m rg.cli gerar-chaves

# Senhas do PostgreSQL (usadas pelo docker-compose)
PG_SUPERUSER_PASSWORD=
RG_OWNER_PASSWORD=
RG_API_PASSWORD=

# Diretório do host com fullchain.pem e privkey.pem
TLS_CERT_DIR=/etc/letsencrypt/live/plataforma.rghospital.com.br

# Segredos da aplicação
RG_SECRET_KEY=
RG_SIGNATURE_SECRET=
RG_ENCRYPTION_KEYS=

RG_AMBIENTE=producao
RG_INSTITUICAO=Hospital Rio Grande
RG_TIMEZONE=America/Sao_Paulo
RG_SESSION_IDLE_MINUTES=60
RG_SESSION_ABSOLUTE_HOURS=12
# Consulta externa de senhas vazadas desligada: nenhum dado sai da infraestrutura do hospital
RG_HIBP_ENABLED=false
RG_MODO_DEMO=false
# Para várias instâncias da API, use Redis no limitador de requisições:
RG_RATELIMIT_STORAGE_URI=memory://
